# Required server configuration
MONGODB_URI=mongodb://127.0.0.1:27017/trakagile
AUTH_SECRET=replace-with-at-least-32-random-bytes

# Required to provision organizations through POST /api/organizations
PLATFORM_ADMIN_KEY=replace-with-a-separate-long-random-secret
# Used only by `npm run platform-admin:create`; do not commit real credentials.
PLATFORM_ADMIN_USERNAME=sysadmin
PLATFORM_ADMIN_NAME=System Administrator
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Required when attendance reminder jobs are called by a scheduler
CRON_SECRET=replace-with-a-separate-long-random-secret

# Optional organization routing defaults
NEXT_PUBLIC_ORGANIZATION_CODE=
